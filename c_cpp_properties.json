{
    "configurations": [
        {
            "name": "Mac-Clang",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/homebrew/include/**"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64",
            "compilerArgs": [
                "-Xpreprocessor",
                "-fopenmp"
            ]
        }
    ],
    "version": 4
}